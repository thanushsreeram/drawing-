# SketchFlow AI Backend Environment Configuration

PROJECT_NAME="SketchFlow AI"
ENVIRONMENT="development"
DEBUG=true

# Server
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000

# CORS Origins (JSON array of allowed origins)
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Storage Paths (relative to backend or project root)
STORAGE_DIR="../storage"
